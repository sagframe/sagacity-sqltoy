<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
	xmlns="http://www.sagframe.com/schema/sqltoy-translate"
	xmlns:tns="http://www.sagframe.com/schema/sqltoy-translate"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.sagframe.com/schema/sqltoy-translate"
	elementFormDefault="qualified">
	<xsd:attributeGroup name="sqlToyTranslateAttrs">
		<xsd:attribute name="cache" type="xsd:string"
			use="required" />
		<xsd:attribute name="keep-alive" type="xsd:integer"
			default="3600">
			<xsd:annotation>
				<xsd:documentation>
				<![CDATA[unit is second]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="heap" type="xsd:integer"
			default="10000">
			<xsd:annotation>
				<xsd:documentation>
				<![CDATA[unit is EntryUnit.ENTRIES]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="off-heap" type="xsd:integer"
			default="0">
			<xsd:annotation>
				<xsd:documentation>
				<![CDATA[unit is MemoryUnit.MB]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="disk-size" type="xsd:integer"
			default="0">
			<xsd:annotation>
				<xsd:documentation>
				<![CDATA[unit is MemoryUnit.MB]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="i18n" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
				<![CDATA[example:zh_cn:1,en_us:2]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="desc" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[cache description]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:attributeGroup>
	<xsd:attributeGroup name="sqlToyTranslateUpdater">
		<xsd:attribute name="cache" type="xsd:string"
			use="required" />
		<xsd:attribute name="has-inside-group"
			type="xsd:boolean" default="false">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[whether the cache has internal groups, e.g. the dictionary classification inside a data dictionary cache]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="check-frequency" type="xsd:string" />
	</xsd:attributeGroup>
	<!-- rest authentication modes: basic(username/password) and jwt(token based) -->
	<xsd:simpleType name="authTypeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="basic" />
			<xsd:enumeration value="jwt" />
		</xsd:restriction>
	</xsd:simpleType>
	<!-- jwt self-signing algorithms(HS: symmetric HMAC with shared secret; RS: asymmetric RSA, signed by private key and verified by public key) -->
	<xsd:simpleType name="signAlgorithmEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="HS256" />
			<xsd:enumeration value="HS384" />
			<xsd:enumeration value="HS512" />
			<xsd:enumeration value="RS256" />
			<xsd:enumeration value="RS384" />
			<xsd:enumeration value="RS512" />
		</xsd:restriction>
	</xsd:simpleType>
	<!-- rest request authentication attributes: basic(existing username/password) and jwt(token based) -->
	<xsd:attributeGroup name="sqlToyTranslateRestAuth">
		<xsd:attribute name="auth-type" type="tns:authTypeEnum">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[rest authentication mode: basic(default, username/password) or jwt(token based); under jwt mode token-url(fetch by login), token-secure-key(self-signed locally) and authorization(static token) are mutually exclusive, and the priority follows this order when multiple are configured]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="token-url" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[the login url to fetch the token under jwt mode: username/password are submitted as a form, the token is extracted from the json response by token-key and cached, re-fetched automatically when nearly expired or on 401]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="token-path" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[the token field path in the login response json under jwt mode, dot path is supported(e.g. data.token), default: access_token]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="token-prefix" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[the token header value prefix under jwt mode, default: Bearer; set to none to send the bare token value without prefix]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="token-header" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[the http header name carrying the token under jwt mode, default: Authorization, e.g. Sag-Auth-Token]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="token-expire" type="xsd:integer">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[the token validity period in seconds under jwt mode, the expires_in in the login response takes precedence when present, default: 1800]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="token-secure-key" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[jwt self-signing mode: configure the signing key directly, the token(with claims sub=username, iat, exp) is generated locally without a login endpoint; for HS256/HS384/HS512 it is the shared secret, for RS256/RS384/RS512 it is the PKCS#8 PEM private key(-----BEGIN PRIVATE KEY-----, convertible by: openssl pkcs8 -topk8 -nocrypt); regenerated automatically when nearly expired, force re-signed and retried once on 401]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="sign-algorithm" type="tns:signAlgorithmEnum">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[the signing algorithm for jwt self-signing mode: HS256(default), HS384, HS512(symmetric HMAC with shared secret) or RS256, RS384, RS512(asymmetric RSA, verified by the server with the public key)]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="authorization" type="xsd:string">
			<xsd:annotation>
				<xsd:documentation>
					<![CDATA[a static token configured directly under jwt mode(long-lived token scenario, mutually exclusive with token-url), sent as the Authorization: {token-prefix} {token} header]]>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:attributeGroup>
	<xsd:element name="sagacity">
		<xsd:complexType>
			<xsd:choice maxOccurs="unbounded">
				<xsd:element name="cache-translates">
					<xsd:complexType>
						<xsd:choice maxOccurs="unbounded">
							<xsd:element name="sql-translate" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>
										<![CDATA[query directly by sql and put the result into cache, the general format is: key, name, segment1, segment2, status
										the first column holds the code, the second holds the name, the rest are extension columns defined as needed, and the status is generally placed in the last column
										]]>
									</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType mixed="true">
									<xsd:sequence minOccurs="0">
										<xsd:element name="sql" type="xsd:string" />
									</xsd:sequence>
									<xsd:attribute name="sql" type="xsd:string" />
									<xsd:attribute name="datasource"
										type="xsd:string" />
									<xsd:attributeGroup
										ref="sqlToyTranslateAttrs" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="service-translate" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>
										<![CDATA[fetch the cache by invoking a spring service, the result should be List<List> or List<Object[]>]]>
									</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:attribute name="service" type="xsd:string"
										use="required">
										<xsd:annotation>
											<xsd:documentation>
									<![CDATA[the serviceName or the java class name, e.g. com.xxx.TranslateService]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attribute name="method" type="xsd:string"
										use="required">
										<xsd:annotation>
											<xsd:documentation>
										<![CDATA[the service method must have one string parameter, e.g. getDictCache(String cacheType)]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attributeGroup
										ref="sqlToyTranslateAttrs" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="rest-translate" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:complexType>
									<xsd:attribute name="url" type="xsd:string"
										use="required" />
									<xsd:attribute name="username" type="xsd:string" />
									<xsd:attribute name="password" type="xsd:string" />
									<xsd:attributeGroup
										ref="sqlToyTranslateRestAuth" />
									<xsd:attributeGroup
										ref="sqlToyTranslateAttrs" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="local-translate" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<xsd:attributeGroup
										ref="sqlToyTranslateAttrs" />
									<xsd:attribute name="properties"
										type="xsd:string" />
									<xsd:attribute name="dynamic-cache"
										type="xsd:boolean">
										<xsd:annotation>
											<xsd:documentation>
											<![CDATA[generally refers to combining local cache and distributed cache for extra large datasets: check the local cache first, then fetch from redis when missing]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attribute name="dynamic-cache-initSize"
										type="xsd:int">
										<xsd:annotation>
											<xsd:documentation>
											<![CDATA[the initial capacity of the dynamic cache map, default 10000]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attribute name="dynamic-cache-maxSize"
										type="xsd:int">
										<xsd:annotation>
											<xsd:documentation>
											<![CDATA[the maximum number of entries in the dynamic cache, default 100000]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attribute name="dynamic-cache-loadFactor"
										type="xsd:float">
										<xsd:annotation>
											<xsd:documentation>
											<![CDATA[the load factor of the dynamic cache map, default 0.75]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attribute name="sid" type="xsd:string">
										<xsd:annotation>
											<xsd:documentation>
											<![CDATA[the identifier used along with dynamic-cache]]>
											</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
								</xsd:complexType>
							</xsd:element>
						</xsd:choice>
						<xsd:attribute name="disk-store-path"
							default="./translateCaches" />
						<xsd:attribute name="default-keep-alive"
							type="xsd:integer" default="3600">
							<xsd:annotation>
								<xsd:documentation>
								<![CDATA[unit is second]]>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:attribute>
						<xsd:attribute name="default-heap"
							type="xsd:integer" default="10000">
							<xsd:annotation>
								<xsd:documentation>
								<![CDATA[unit is EntryUnit.ENTRIES]]>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:attribute>
						<xsd:attribute name="default-off-heap"
							type="xsd:integer" default="0">
							<xsd:annotation>
								<xsd:documentation>
								<![CDATA[unit is MemoryUnit.MB]]>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:attribute>
						<xsd:attribute name="default-disk-size"
							type="xsd:integer" default="0">
							<xsd:annotation>
								<xsd:documentation>
								<![CDATA[unit is MemoryUnit.MB]]>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:attribute>
					</xsd:complexType>

				</xsd:element>
				<xsd:element name="cache-update-checkers" minOccurs="0"
					maxOccurs="1">
					<xsd:annotation>
						<xsd:documentation>
							<![CDATA[
							1. the result must be two columns: cacheName, cacheType(can be null); the request parameter: lastUpdateTime;
							2. check-frequency: can be a single number such as 5(check every 5 seconds), or a segmented mode such as 0..10:20?300,10:20..20?15,20..24?150
							]]>
						</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:choice maxOccurs="unbounded">
							<xsd:element name="sql-checker" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<!-- sql supports three forms: the sql="sqlId" attribute reference, the <sql> child element, or sql written directly inside the element, so the child element is optional -->
									<xsd:sequence minOccurs="0">
										<xsd:element name="sql" type="xsd:string" />
									</xsd:sequence>
									<xsd:attribute name="id" type="xsd:string" />
									<xsd:attribute name="sql" type="xsd:string" />
									<xsd:attribute name="check-frequency"
										type="xsd:string" />
									<xsd:attribute name="datasource"
										type="xsd:string" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="service-checker" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<xsd:attribute name="id" type="xsd:string" />
									<xsd:attribute name="service" type="xsd:string"
										use="required" />
									<xsd:attribute name="method" type="xsd:string"
										use="required" />
									<xsd:attribute name="check-frequency"
										type="xsd:string" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="rest-checker" minOccurs="0"
								maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<xsd:attribute name="id" type="xsd:string" />
									<xsd:attribute name="url" type="xsd:string"
										use="required" />
									<xsd:attribute name="check-frequency"
										type="xsd:string" />
									<xsd:attribute name="username" type="xsd:string" />
									<xsd:attribute name="password" type="xsd:string" />
									<xsd:attributeGroup
										ref="sqlToyTranslateRestAuth" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="sql-increment-checker"
								minOccurs="0" maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<!-- sql supports three forms: the sql="sqlId" attribute reference, the <sql> child element, or sql written directly inside the element, so the child element is optional -->
									<xsd:sequence minOccurs="0">
										<xsd:element name="sql" type="xsd:string" />
									</xsd:sequence>
									<xsd:attribute name="sql" type="xsd:string" />
									<xsd:attributeGroup
										ref="sqlToyTranslateUpdater" />
									<xsd:attribute name="datasource"
										type="xsd:string" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="service-increment-checker"
								minOccurs="0" maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<xsd:attribute name="service" type="xsd:string"
										use="required" />
									<xsd:attribute name="method" type="xsd:string"
										use="required" />
									<xsd:attributeGroup
										ref="sqlToyTranslateUpdater" />
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="rest-increment-checker"
								minOccurs="0" maxOccurs="unbounded">
								<xsd:complexType mixed="true">
									<xsd:attribute name="url" type="xsd:string"
										use="required" />
									<xsd:attributeGroup
										ref="sqlToyTranslateUpdater" />
									<xsd:attribute name="username" type="xsd:string" />
									<xsd:attribute name="password" type="xsd:string" />
									<xsd:attributeGroup
										ref="sqlToyTranslateRestAuth" />
								</xsd:complexType>
							</xsd:element>
						</xsd:choice>
						<xsd:attribute name="cluster-time-deviation"
							type="xsd:integer" default="1">
							<xsd:annotation>
								<xsd:documentation>
									<![CDATA[
										the time deviation among cluster nodes(in seconds), the base check time is reduced by this deviation when detecting cache updates.
									]]>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:attribute>
					</xsd:complexType>
				</xsd:element>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>